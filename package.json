{
  "name": "lga",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev --workspace=api\" \"npm run dev --workspace=web\"",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
